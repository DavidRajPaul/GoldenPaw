# GoldenPaw Edge Function secrets. scripts/setup-supabase.sh copies this to supabase/secrets.env
# (git-ignored), fills the generated tokens, and uploads every non-empty value.
# Leave anything blank that you don't have yet; re-run the script later to add it.

# --- Generated for you by the script (keep a copy in your password manager) ---
PUSH_ADMIN_TOKEN=
REVENUECAT_WEBHOOK_AUTH=

# --- AI weekly summaries (optional): console.anthropic.com → API keys ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- New-ticket emails (optional): resend.com → API keys ---
# Until your domain is verified in Resend, SUPPORT_NOTIFY_EMAIL must be the email you signed up to Resend with.
RESEND_API_KEY=
SUPPORT_NOTIFY_EMAIL=
SUPPORT_ALERT_FROM=

# --- Android push: path to the Firebase service-account JSON file (Phase 4) ---
FCM_SERVICE_ACCOUNT_FILE=

# --- iOS push (Phase 6, needs the Apple account) ---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.goldenpaw.app
APNS_PRIVATE_KEY_FILE=
# true for TestFlight / App Store builds, false only for debug builds run from Xcode
APNS_PRODUCTION=true

# --- RevenueCat (Phase 7): Project settings → API keys → Secret key (sk_...) ---
REVENUECAT_SECRET_KEY=
